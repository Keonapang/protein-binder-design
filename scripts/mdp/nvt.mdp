######################################################
# Calculate binding free energy using GROMACS + g_mmpbsa
title       = NVT
integrator  = md
dt          = 0.002
nsteps      = 50000       ; 100 ps
nstxout     = 0
nstvout     = 0
nstenergy   = 1000
nstlog      = 1000
nstxout-compressed = 1000
cutoff-scheme = Verlet
rlist       = 1.0
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = PME
tcoupl      = V-rescale
tc-grps     = System
tau-t       = 0.1
ref-t       = 300
pcoupl      = no
pbc         = xyz
constraints = h-bonds