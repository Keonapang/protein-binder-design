######################################################
# Calculate binding free energy using GROMACS + g_mmpbsa


title       = Production
integrator  = md
dt          = 0.002
nsteps      = 500000      ; 1 ns by default (edited by script)
nstxout     = 0
nstvout     = 0
nstenergy   = 1000
nstlog      = 1000
nstxout-compressed = 1000
cutoff-scheme = Verlet
rlist       = 1.0
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = PME
tcoupl      = V-rescale
tc-grps     = System
tau-t       = 0.1
ref-t       = 300
pcoupl      = Parrinello-Rahman
tau-p       = 2.0
ref-p       = 1.0
compressibility = 4.5e-5
pbc         = xyz
constraints = h-bonds